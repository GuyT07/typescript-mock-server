{
  "compilerOptions": {
    "target": "es2017",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "outDir": "dist"
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "tms-models/**/*"
  ]
}
